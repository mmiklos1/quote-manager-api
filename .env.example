# Values are unset on purpose.
# No local database name, user, password, or port was chosen.
# Do not commit a filled .env file.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# The pg driver and Prisma read this. Build it from the values you chose.
# No sample URL is included, because a sample would pick a database name.
DATABASE_URL=

# TCP port for this API process. 8080 is not a product requirement.
PORT=

# HMAC secret for access tokens. At least 32 characters. Do not commit a real key.
JWT_SIGNING_KEY=

# OAuth client secrets, if this API later runs the provider redirect.
# Callback URLs are not named yet. Leave these blank. Nothing calls the providers with them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
