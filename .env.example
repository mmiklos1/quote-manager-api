# Local Docker Postgres only. Do not commit a filled .env file.
# These values are the local database. They are not a production secret.

POSTGRES_USER=user
POSTGRES_PASSWORD=postgres
POSTGRES_DB=quote_manager_db
POSTGRES_PORT=5432

# The pg driver and Prisma read this.
DATABASE_URL=postgresql://user:postgres@localhost:5432/quote_manager_db

# TCP port for this API process. 8080 is not a product requirement.
PORT=

# HMAC secret for access tokens. At least 32 characters. Do not commit a real key.
JWT_SIGNING_KEY=

# OAuth client secrets, if this API later runs the provider redirect.
# Callback URLs are not named yet. Leave these blank. Nothing calls the providers with them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
