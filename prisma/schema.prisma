// Identity records for F-003.
// The column list in the spec is the list. Do not add profile fields,
// two-factor columns, or keys inside Permission.access.
//
// SQL-only rules live in the first migration and are not representable here:
// one is_admin row per company (partial unique index), status and provider
// checks, the normalized-email check, and the same-company permission trigger.
// Do not apply a later migrate diff that drops those.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  seatLimit       Int      @map("seat_limit")
  /// ISO 3166-1 alpha-2. Null when unset; catalog writes then cannot resolve a currency.
  countryOfOrigin String?  @map("country_of_origin")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  companyUsers         CompanyUser[]
  permissions          Permission[]
  catalogItems         CatalogItem[]
  catalogRequirements  CatalogRequirement[]

  @@map("companies")
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  isSuperAdmin       Boolean  @default(false) @map("is_super_admin")
  /// True when a license included a temporary password. Default false covers SSO and existing rows.
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  companyUsers      CompanyUser[]
  userPassword      UserPassword?
  passwordHistories PasswordHistory[]
  linkedLogins      LinkedLogin[]
  sessions          Session[]
  passwordResets    PasswordReset[]

  @@map("users")
}

model CompanyUser {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  status        String
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permissions CompanyUserPermission[]
  sessions    Session[]

  @@unique([companyId, userId])
  @@index([companyId, status])
  @@map("company_users")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  isAdmin   Boolean  @default(false) @map("is_admin")
  /// Opaque jsonb. Do not invent keys. Null means no document is stored.
  access    Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grants  CompanyUserPermission[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("permissions")
}

model CompanyUserPermission {
  id            String @id @default(uuid()) @db.Uuid
  companyUserId String @map("company_user_id") @db.Uuid
  permissionId  String @map("permission_id") @db.Uuid

  companyUser CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission  Permission  @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyUserId, permissionId])
  @@map("company_user_permissions")
}

model UserPassword {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("user_passwords")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@map("password_histories")
}

model LinkedLogin {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @map("user_id") @db.Uuid
  provider        String
  providerSubject String @map("provider_subject")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("linked_logins")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  companyUserId String    @map("company_user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  companyUser CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyUserId])
  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// Stage 1 sales catalog (F-007). UI Type is not a column.
// The unique identity includes soft-deleted rows, so a deleted item still holds its key.
// catalog_requirements also has a SQL check that the two item ids differ.

model CatalogItem {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  name              String
  description       String
  manufacturer      String
  model             String
  year              Int
  rentalRatePerDay  Decimal   @map("rental_rate_per_day") @db.Decimal(12, 2)
  imageKey          String    @map("image_key")
  derivativeKey     String?   @map("derivative_key")
  metadata          Json?     @db.JsonB
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requiring    CatalogRequirement[] @relation("CatalogRequiring")
  requiredBy   CatalogRequirement[] @relation("CatalogRequired")

  @@unique([companyId, manufacturer, model, year, name])
  @@index([companyId, deletedAt])
  @@map("catalog_items")
}

model CatalogRequirement {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  requiringItemId  String    @map("requiring_item_id") @db.Uuid
  requiredItemId   String    @map("required_item_id") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company        Company     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requiringItem  CatalogItem @relation("CatalogRequiring", fields: [requiringItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requiredItem   CatalogItem @relation("CatalogRequired", fields: [requiredItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([requiringItemId, requiredItemId])
  @@index([companyId, deletedAt])
  @@index([requiredItemId])
  @@map("catalog_requirements")
}
