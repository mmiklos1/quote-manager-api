{
  "name": "quote-manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/server.ts",
    "start:dist": "node dist/server.js",
    "test": "node --import tsx --test",
    "prisma:generate": "prisma generate",
    "user:insert": "node scripts/insert-local-user.js",
    "company:insert": "node scripts/insert-local-company.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.901.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.0",
    "pino": "10.4.0",
    "sharp": "0.34.4",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "7.0.2"
  }
}
